generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String
  longDescription String?
  price           Int      // price in HUF (fillér-free)
  category        String   // "pillow" | "poster"
  series          String   // "origin" | "nova"
  variant         String   // "core" | "linea" | "atelier"
  imageUrl        String
  images          String[] @default([])
  sortOrder       Int      @default(0)
  badge           String?  // "Core Series" | "Limited Edition" | null
  active          Boolean  @default(true)
  hiddenFromListing Boolean @default(false)
  onSale          Boolean  @default(false)
  salePrice       Int?
  // True only for non-personalised goods that carry the 14-day right of
  // withdrawal (e.g. NOLA Crew cape, crowns). Personalised products are exempt.
  withdrawalEligible Boolean @default(false)
  // True for digital / no-ship goods (e.g. digital gift card, digital poster):
  // checkout charges no shipping, and a cart of only such items ships free.
  noShipping      Boolean  @default(false)
  // --- Admin-editable product sheet (all optional; hidden when empty) ---
  /// Stock on hand. null = untracked (always orderable), 0 = sold out.
  stock           Int?
  /// e.g. "kb. 2 hét" — overrides the category default in the trust bar.
  productionTime  String?
  /// e.g. "100% OEKO-TEX® pamut duplagéz"
  material        String?
  /// e.g. "30 × 30 cm"
  size            String?
  /// Washing / care instructions.
  careInfo        String?
  /// Trust-bar rows / product highlights. Empty = category defaults.
  features        String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems OrderItem[]
  variants   ProductVariant[]
}

/// A selectable variant of a product (e.g. one of the six NOLA Hush colours,
/// or one of the three two-sided NOLA Cloud colourways). Rendered as a labelled
/// swatch picker on the product page — never as a plain dropdown.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Display label, e.g. "Púderrózsaszín" or "Bézs – Cappuccino".
  name      String
  /// Swatch colour(s). colorHex2 is set for two-sided colourways.
  colorHex  String?
  colorHex2 String?
  /// Variant-specific gallery. When non-empty it replaces the product gallery
  /// while this variant is selected; the first image is the main image.
  images    String[] @default([])
  /// Surcharge (or discount, if negative) on top of the product price.
  priceDiff Int      @default(0)
  /// Stock on hand for this variant. null = untracked, 0 = sold out.
  stock     Int?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Order {
  id              String   @id @default(cuid())
  status          String   @default("pending") // pending | paid | processing | shipped | delivered | cancelled
  email           String
  phone           String?
  shippingName    String
  shippingZip     String
  shippingCity    String
  shippingAddress String
  shippingNote    String?
  billingZip      String?
  billingCity     String?
  billingAddress  String?
  billingCountry  String   @default("HU") // invoice country (ISO-2)
  subtotal        Int
  shippingCost    Int      @default(0)
  total           Int
  // Applied coupon (if any) — persisted so notifications/admin can show it.
  couponCode      String?
  discount        Int      @default(0)
  paymentMethod   String   @default("card") // "card" | "transfer"
  stripePaymentId String?
  trackingNumber  String?
  // Timestamps of fulfilment status transitions — the 14-day withdrawal
  // window is measured from delivery (deliveredAt).
  shippedAt       DateTime?
  deliveredAt     DateTime?
  // Shipping routing: HU → Foxpost; the 7 neighbouring countries → Packeta.
  shippingCountry String   @default("HU") // ISO-2, e.g. "HU", "SK", "RO"
  shippingCarrier String   @default("foxpost") // "foxpost" | "packeta"
  // Structured pickup-point id (Foxpost place_id or Packeta point id).
  // Replaces the legacy overloading of shippingNote.
  pickupPointId   String?
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items OrderItem[]
  withdrawals WithdrawalRequest[]
}

model OrderItem {
  id        String @id @default(cuid())
  quantity  Int
  price     Int
  // Personalization: birth data for pillow/poster
  babyName      String?
  birthDate     String?
  birthWeight   String?
  birthHeight   String?
  birthTime     String?
  customNote    String?
  posterLayout  String?  // chosen poster design variant (e.g. "origin-1")

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Customer {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  image           String?
  phone           String?
  passwordHash    String?
  emailVerified   Boolean  @default(false)
  verificationToken        String?
  verificationTokenExpires DateTime?
  passwordResetToken        String?
  passwordResetTokenExpires DateTime?
  shippingName    String?
  shippingZip     String?
  shippingCity    String?
  shippingAddress String?
  shippingNote    String?
  billingZip      String?
  billingCity     String?
  billingAddress  String?
  newsletter      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders Order[]

  @@index([verificationToken])
  @@index([passwordResetToken])
}

model Category {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String   // Hungarian display name: "Párnák"
  nameEn        String?  // English display name for fancy header: "KEEPSAKES"
  /// Category card image (1:1), shown on the umbrella category page.
  imageUrl      String?
  /// Umbrella group this category belongs to: "kicsiknek" | "nagyoknak".
  parent        String?
  sortOrder     Int      @default(0)
  visibleOnHome Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  text      String
  textColor String   @default("#FFFFFF")
  bgColor   String   @default("#4A4A4A")
  href      String?  // optional link
  bold      Boolean  @default(false)
  active    Boolean  @default(false)
  endsAt    DateTime? // auto-deactivate (null = manual only)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String   @default("")
  discountType    String   // "percent" | "fixed"
  discountValue   Int      // percent (1-100) or fixed HUF amount
  minOrderAmount  Int?     // minimum order value in HUF (optional)
  usageLimit      Int?     // max total uses (null = unlimited)
  usageCount      Int      @default(0)
  // Scope: empty arrays = applies to all products/categories
  productIds      String[] @default([])
  categorySlugs   String[] @default([])
  // When true, parcel locker shipping is free; home delivery unaffected.
  freeShippingOnParcel Boolean @default(false)
  // Origin tag for grouping in admin, e.g. "newsletter" for auto-generated
  // welcome coupons (their description holds the subscriber's e-mail).
  source          String?
  active          Boolean  @default(true)
  startsAt        DateTime
  endsAt          DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// A "landing card" that points at a real Product. Used for posters so the
/// homepage/listing can show ORIGIN poszter + NOVA poszter as separate cards
/// while all orders/cart/stats go against one canonical Product ("poszter").
model ProductAlias {
  id                String   @id @default(cuid())
  slug              String   @unique // URL slug, e.g. "origin-poszter"
  name              String            // Display name, e.g. "ORIGIN poszter"
  imageUrl          String            // Card image
  badge             String?
  targetProductSlug String            // Canonical Product.slug the alias points to
  defaultLayoutId   String            // Preselected layout id (e.g. "origin-1")
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// An online right-of-withdrawal declaration ("elállás a szerződéstől"), as
/// required by 45/2014. (II. 26.) Korm. rendelet. Stores a durable snapshot of
/// the declaration so it can serve as proof; the acknowledgment email carries
/// the same content plus the send timestamp.
model WithdrawalRequest {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  // Declared by the consumer in the form.
  declaredName  String
  contactEmail  String
  // "received" | "acknowledged" | "refunded" | "rejected"
  status        String   @default("received")
  // Total value of the withdrawn items at time of declaration (HUF).
  refundAmount  Int      @default(0)
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items WithdrawalItem[]

  @@index([orderId])
}

model WithdrawalItem {
  id            String   @id @default(cuid())
  withdrawalId  String
  withdrawal    WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  orderItemId   String
  // Snapshot fields (kept even if the product later changes).
  productName   String
  quantity      Int
  unitPrice     Int

  @@index([withdrawalId])
}
